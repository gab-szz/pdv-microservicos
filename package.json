{
  "name": "projeto-pdv",
  "private": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev:estoque": "pnpm --filter estoque-microservico dev",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter estoque-microservico test:integration",
    "infra:up": "cd ./containers && docker compose --profile infra up -d",
    "infra:down": "cd ./containers && docker compose --profile infra down"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
